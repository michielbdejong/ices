    "version": "0.2.0",
    "configurations": [
        {
            "name": "Listen for XDebug from Docker",
            "type": "php",
            "request": "launch",
            "port": 9029,
            "pathMappings": {
                "/var/www/html/sites/all/modules/ices": "${workspaceRoot}",
                "/var/www/html/sites/all/modules/oauth2_server": "${workspaceRoot}/.debug/oauth2_server",
                "/var/www/html/": "${workspaceRoot}/.debug/drupal-7.69",
            },
        },
    ]
}