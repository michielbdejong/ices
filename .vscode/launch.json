    "version": "0.2.0",
    "configurations": [
        {
            "name": "Listen for XDebug from Docker",
            "type": "php",
            "request": "launch",
            "port": 9029,
            "pathMappings": {
                "/var/www/html/sites/all/modules/oauth2_server": "C:\\Users\\Personal\\projects\\ices\\.debug\\oauth2_server",
                "/var/www/html/sites/all/libraries/oauth2-server-php": "C:\\Users\\Personal\\projects\\ices\\.debug\\oauth2-server-php",
                "/var/www/html/sites/all/libraries/json-api": "C:\\Users\\Personal\\projects\\ices\\.debug\\json-api",
                "/var/www/html/sites/all/modules/entity": "C:\\Users\\Personal\\projects\\ices\\.debug\\entity",
                "/var/www/html/sites/all/modules/geocoder": "C:\\Users\\Personal\\projects\\ices\\.debug\\geocoder",
                "/var/www/html/sites/all/modules/ices": "${workspaceRoot}",
                "/var/www/html/": "${workspaceRoot}/.debug/drupal-7.95",
            },
        },
    ]
}