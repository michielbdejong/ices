<?php

require_once __DIR__ . '/ces_komunitin.mail.inc';

/**
 * @file
 * Drupal hooks for the ICES komunitin module.
 */

/**
 * @defgroup ces_komunitin_module ICES komunitin module
 * @ingroup ces_komunitin
 * @{
 * ICES komunitin module.
 */

 /**
  * Implements hook_module_implements_alter
  *
  * Ensures this is the last init hook call.
  */
function ces_komunitin_module_implements_alter(&$implementations, $hook) {
  if ($hook == 'init') {
    $impl = $implementations['ces_komunitin'];
    unset($implementations['ces_komunitin']);
    $implementations['ces_komunitin'] = $impl;
  }
}
/**
 * Implements hook_init().
 *
 * Exit on OPTIONS requests so we dont check for Authorization.
 */
function ces_komunitin_init() {
  if ($_SERVER['REQUEST_METHOD'] == "OPTIONS") {
    exit(0);
  }
}
/**
 * Implements hook_menu.
 */
function ces_komunitin_menu() {
  $items = array();
  $items['ces/api'] = array(
    'page callback' => 'ces_komunitin_api',
    'type' => MENU_CALLBACK,
    'file' => 'ces_komunitin.api.inc',
    'file path' => drupal_get_path('module', 'ces_komunitin'),
    'access callback' => TRUE
  );
  $items['oauth2/reset-password'] = array(
    'page callback' => 'ces_komunitin_api_auth_reset_password',
    'type' => MENU_CALLBACK,
    'file' => 'ces_komunitin.api.auth.inc',
    'file path' => drupal_get_path('module', 'ces_komunitin'),
    'access callback' => TRUE
  );
  $items['oauth2/resend-validation'] = array(
    'page callback' => 'ces_komunitin_api_auth_resend_validation_email',
    'type' => MENU_CALLBACK,
    'file' => 'ces_komunitin.api.auth.inc',
    'file path' => drupal_get_path('module', 'ces_komunitin'),
    'access callback' => TRUE
  );
  $items['ces/files'] = array(
    'page callback' => 'ces_komunitin_files',
    'type' => MENU_CALLBACK,
    'file' => 'ces_komunitin.files.inc',
    'file path' => drupal_get_path('module', 'ces_komunitin'),
    'access callback' => TRUE
  );
  $items['admin/config/services/komunitin'] = array(
    'title' => 'Komunitin settings',
    'description' => 'Change global settings related to Komunitin API.',
    'page callback' => 'drupal_get_form',
    'page arguments' => array('ces_komunitin_admin_form'),
    'access arguments' => array('administer site configuration'),
    'type' => MENU_NORMAL_ITEM,
  );
  return $items;
}

/**
 * Implements hook_xautoload().
 *
 * Load all libraries required with composer.
 */
function ces_komunitin_xautoload($adapter) {
  // I don't know why composer may require twice the same project and then it
  // throws  "cannot redeclare" php error. I've seen that only in tests.
  if (!class_exists('MailerSend\MailerSend')) {
    $adapter->absolute()->composerDir('vendor/composer');
  }
}

/**
 * Implements hook_libraries_info().
 */
function ces_komunitin_libraries_info()
{
  $libraries = array();
  $libraries['json-api'] = array(
    'name' => 'JSON API',
    'vendor url' => 'https://github.com/neomerx/json-api',
    'xautoload' => function ($adapter) {
      /** @var \Drupal\xautoload\Adapter\LocalDirectoryAdapter $adapter */
      // Scan sites/all/libraries/json-api/composer.json to look for
      // autoload information.
      $adapter->composerJson('composer.json');
    },
  );
  $libraries['html-to-markdown'] = array(
    'name' => 'HTML To Markdown for PHP',
    'vendor url' => 'https://github.com/thephpleague/html-to-markdown',
    'xautoload' => function ($adapter) {
      $adapter->composerJson('composer.json');
    }
  );
  return $libraries;
}
/**
 * The configuration settings for the komunitin module.
 */
function ces_komunitin_admin_form() {
  $events_user = getenv('NOTIFICATIONS_EVENTS_USERNAME');
  $events_pass = getenv('NOTIFICATIONS_EVENTS_PASSWORD');
  $mailersend_key = getenv('MAILERSEND_API_KEY');

  $form = array();
  $form['ces_komunitin_events_username'] = array(
    '#type' => 'textfield',
    '#title' => t('Events service username'),
    '#default_value' => variable_get('ces_komunitin_events_username', $events_user),
    '#description' => t('The username to authenticate to the Komunitin events service.'),
  );
  $form['ces_komunitin_events_password'] = array(
    '#type' => 'textfield',
    '#title' => t('Events service password'),
    '#default_value' => variable_get('ces_komunitin_events_password', $events_pass),
    '#description' => t('The password to authenticate to the Komunitin events service.'),
  );
  $form['ces_komunitin_app_url'] = array(
    '#type' => 'textfield',
    '#title' => t('Komunitin app URL'),
    '#default_value' => variable_get('ces_komunitin_app_url', 'https://komunitin.org'),
    '#description' => t('The URL of the Komunitin app.'),
  );
  $form['ces_komunitin_mailersend_api_key'] = array(
    '#type' => 'textfield',
    '#title' => t('Mailersend API key'),
    '#default_value' => variable_get('ces_komunitin_mailersend_api_key', $mailersend_key),
    '#description' => t('The API key to authenticate to the Mailersend service.'),
  );
  $form['ces_komunitin_app_mail'] = array(
    '#type' => 'textfield',
    '#title' => t('Komunitin app mail'),
    '#default_value' => variable_get('ces_komunitin_app_mail', 'app@komunitin.org'),
    '#description' => t('The sender address of mails sent by the Komunitin module.'),
  );
  $form['ces_komunitin_app_mail_name'] = array(
    '#type' => 'textfield',
    '#title' => t('Komunitin app mail name'),
    '#default_value' => variable_get('ces_komunitin_app_mail_name', 'Komunitin app'),
    '#description' => t('The sender name of mails sent by the Komunitin module.'),
  );

  return system_settings_form($form);
}


/**
 * Implements hook_notification invoked by function ces_message_send_notify at
 * ces_message/ces_message.module.
 */
function ces_komunitin_notification($action, $exchange_id, $user_recipient_id, $params, $sender_id = false) {
  module_load_include('inc', 'ces_komunitin', 'ces_komunitin.notifications');
  ces_komunitin_notification_event($action, $exchange_id, $user_recipient_id, $params, $sender_id);
}

/**
 * Implements hook_entity_insert().
 *
 * @param $entity: The entity object.
 * @param $type: The type of entity being inserted (i.e. node, user, comment)
 */
function ces_komunitin_entity_insert($entity, $type) {
  // Adding this superfluous if because otherwise we find errors on module installation
  if ($type == 'ces_offerwant')  {
    module_load_include('inc', 'ces_komunitin', 'ces_komunitin.notifications');
    ces_komunitin_notifications_entity_change($entity, $type);
  }
}

function ces_komunitin_entity_update($entity, $type) {
  // Adding this superfluous if because otherwise we find errors on module installation
  if ($type == 'ces_offerwant') {
    module_load_include('inc', 'ces_komunitin', 'ces_komunitin.notifications');
    ces_komunitin_notifications_entity_change($entity, $type);
  }
}

/**
 * Implements hook_cron().
 */
function ces_komunitin_cron() {
  $last_cron = variable_get('ces_komunitin_cron_last_run', 0);
  // Get published offers and wants that expired after last run.
  $result = db_query("SELECT o.id, o.type, o.user, e.id as exchangeId, e.code as exchangeCode
    FROM {ces_offerwant} o
    LEFT JOIN {ces_category} c ON o.category = c.id
    LEFT JOIN {ces_exchange} e ON c.exchange = e.id
    WHERE o.state = 1 AND o.expire > :last_cron AND o.expire <= :nowtime", array(
    ':last_cron' => $last_cron,
    ':nowtime' => REQUEST_TIME
  ));
  $expireds = $result->fetchAll();
  watchdog('ces_komunitin', 'Expired @count offers and wants.', array('@count' => count($expireds)), WATCHDOG_INFO);

  $queue = DrupalQueue::get('ces_komunitin_notifications');
  foreach ($expireds as $expired) {
    $queue->createItem($expired);
  }
  variable_set('ces_komunitin_cron_last_run', REQUEST_TIME);
}

/**
 * Implements hook_cron_queue_info().
 */
function ces_komunitin_cron_queue_info() {
  $queues['ces_komunitin_notifications'] = array(
    'worker callback' => 'ces_komunitin_notifications_cron_worker',
    'time' => 60,
  );
  return $queues;
}
/**
 * Queue worker function calling the notifications service.
 */
function ces_komunitin_notifications_cron_worker($expired) {
  module_load_include('inc', 'ces_komunitin', 'ces_komunitin.notifications');
  module_load_include('inc', 'ces_komunitin', 'ces_komunitin.api.social');

  $account = _ces_komunitin_api_social_user_account_id($expired->user, $expired->exchangeId);
  $member = ces_komunitin_api_social_get_uuid(ResourceTypes::MEMBER, $account);
  if ($expired->type == 'offer') {
    ces_komunitin_event(Event::OFFER_EXPIRED, $expired->exchangeCode, array(
      'offer' => ces_komunitin_api_social_get_uuid(ResourceTypes::OFFER, $expired->id),
      'member' => $member
    ));
  } else {
    ces_komunitin_event(Event::NEED_EXPIRED, $expired->exchangeCode, array(
      'need' => ces_komunitin_api_social_get_uuid(ResourceTypes::NEED, $expired->id),
      'member' => $member
    ));
  }
}

/**
 * Implements hook_oauth2_server_token().
 */
function ces_komunitin_oauth2_server_token($server, $request, $response) {
  // Activate user in case this is a authorization code request.
  if ($request->request['client_id'] == 'komunitin-app' && $request->request['grant_type'] === 'authorization_code'
    && (($access_token = $response->getParameter('access_token')) != NULL)) {
    // Succesful login by authorization code. This means we can verify user email and hence unblock user.
    $token = oauth2_server_token_load($access_token);
    $user = user_load($token->uid);
    if ($user->status == 0) {
      $user = user_save($user, ['status' => 1]);
      watchdog('ces_komunitin', 'Verified email %email', ['%email' => $user->mail]);
    }
  }

}
