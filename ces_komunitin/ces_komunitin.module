<?php
/**
 * @file
 * Drupal hooks for the ICES komunitin module.
 */

/**
 * @defgroup ces_komunitin_module ICES komunitin module
 * @ingroup ces_komunitin
 * @{
 * ICES komunitin module.
 */

 /**
  * Implements hook_module_implements_alter
  *
  * Ensures this is the last init hook call.
  */
function ces_komunitin_module_implements_alter(&$implementations, $hook) {
  if ($hook == 'init') {
    $impl = $implementations['ces_komunitin'];
    unset($implementations['ces_komunitin']);
    $implementations['ces_komunitin'] = $impl;
  }
}
/**
 * Implements hook_init().
 * 
 * Exit on OPTIONS requests so we dont check for AUthorization.
 */
function ces_komunitin_init() {
  if ($_SERVER['REQUEST_METHOD'] == "OPTIONS") {
    exit(0);
  }
}
