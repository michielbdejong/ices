<?php
require_once dirname(__FILE__) . '/../ces_bank/ces_bank.test';
/**
 * Komunitin test.
 */
class CesKomunitinestCase extends CesBankTestCase
{

  public function setUp()
  {
    parent::setUp();

    // Grant the anonymous users the permission to use oauth2.
    $anon_role = user_role_load_by_name('anonymous user');
    user_role_grant_permissions($anon_role->rid, array('use oauth2 server'));
    $auth_role = user_role_load_by_name('authenticated user');
    user_role_grant_permissions($auth_role->rid, array('use oauth2 server'));
  }
  /**
   * Implementation of getInfo().
   */
  public static function getInfo()
  {
    return array(
      'name' => 'ICES Komunitin',
      'description' => 'Test Komunitin API implementation.',
      'group' => 'ICES',
    );
  }
  /**
   * Overrides parent method..
   */
  protected function getNeededModules()
  {
    $modules = parent::getNeededModules();
    $modules[] = 'ces_komunitin';
    return $modules;
  }
  /**
   * Test All.
   */
  protected function testAll()
  {
    $this->createExchanges();
    $this->createAccounts();
    // Now we are ready to test opentransact.
    $this->doAccountingApi();
  }

  /**
   * Test the accounting API.
   */
  protected function doAccountingApi()
  {
    // Authenticate as HORA0001
    $account = $this->account11;
    $token = $this->authorize($account['account']['mail'], $account['account']['pass_raw']);
    // Get account objects.
    $hora1 = $this->getAccount($token, 'HORA', 'HORA0001');
    $hora2 = $this->getAccount($token, 'HORA', 'HORA0002');

    // Perform payment
    $transaction1 = $this->doKomunitinTransfer($token, 'HORA', $hora1->data->id, $hora2->data->id, 400, 'First komunitin transaction');
    // Get transaction
    $transaction1 = $this->getKomunitinTransfer($token, 'HORA', $transaction1->data->id, 200, $transaction1);
    // Check duplicated id.
    $this->doKomunitinTransfer($token, 'HORA', $hora1->data->id, $hora2->data->id, 100, 'Duplicated id transaction', 409, $transaction1->data->id);
    // Perform charge.
    $transaction2 = $this->doKomunitinTransfer($token, 'HORA', $hora2->data->id, $hora1->data->id, 500, 'Second komunitin transaction');

    // Check authorization error
    $this->doKomunitinTransfer('invalid', 'HORA', $hora1->data->id, $hora2->data->id, 100, 'Unauthorized transaction', 401);
    // Get external account
    $bcna1 = $this->getAccount($token, 'BCNA', 'BCNA0001');
    // Check interexchange transaction (not implemented)
    $this->doKomunitinTransfer($token, 'HORA', $hora1->data->id, $bcna1->data->id, 100, 'Not implemented feature', 501);
    $hora0 = $this->getAccount($token, 'HORA', 'HORA0000');
    // Check access error.
    $this->doKomunitinTransfer($token, 'HORA', $hora0->data->id, $hora2->data->id, 100, 'Forbidden transaction', 403);

    // List all own account transfers.
    $this->listTransfers($token, 'HORA', $hora1->data->id, 200, array($transaction2, $transaction1));

    // Delete transaction2 (OK/No content)
    $this->deleteKomunitinTransfer($token, 'HORA', $transaction1->data->id, 204);
    // Delete again (not found)
    $this->deleteKomunitinTransfer($token, 'HORA', $transaction1->data->id, 404);

    // Authenticate as BCNA0001
    $account2 = $this->account21;
    $token = $this->authorize($account2['account']['mail'], $account2['account']['pass_raw']);

    // Check access error (API returns 404 on read access forbidden).
    $this->getKomunitinTransfer($token, 'HORA', $transaction1->data->id, 404);
    $this->deleteKomunitinTransfer($token, 'HORA', $transaction1->data->id, 404);
    // List other account transactions: empty list as user has no access to them.
    $this->listTransfers($token, 'HORA', $hora1->data->id, 200, array());
  }
  /**
   * Get a komunitin account object given its code.
   */
  protected function getAccount($token, $exchange_id, $account_code, $status = 200)
  {
    $url = url('ces/api/accounting/' . $exchange_id . '/accounts/' . $account_code, array('absolute' => TRUE));
    $options = array(
      'method' => 'GET',
      'headers' => array(
        'Authorization' => 'Bearer ' . $token,
      ),
    );
    $result = drupal_http_request($url, $options);
    $this->assertEqual($result->code, $status, format_string('Status code should be @status but is @code', array('@status' => $status, '@code' => $result->code)));
    $this->assertEqual($result->headers['content-type'], "application/vnd.api+json");
    $data = json_decode($result->data);
    $this->assertEqual($data->data->type, 'accounts');
    $this->assertEqual($data->data->attributes->code, $account_code);
    return $data;
  }

  /**
   * Perform a Transfer.
   *
   * @return The decoded object in data response.
   */
  protected function doKomunitinTransfer($token, $exchange_id, $payer_id, $payee_id, $amount, $meta, $status = 201, $id = NULL)
  {
    $url = url('ces/api/accounting/' . $exchange_id . '/transfers', array('absolute' => TRUE));
    if ($id === NULL) {
      $id = $this->uuid();
    }
    $data = json_encode(array(
      'data' => array(
        'type' => 'transfers',
        'id' => $id,
        'attributes' => array(
          'state' => 'committed',
          'amount' => $amount,
          'meta' => $meta,
        ),
        'relationships' => array(
          'payer' => array(
            'data' => array(
              'type' => 'accounts',
              'id' => $payer_id
            ),
          ),
          'payee' => array(
            'data' => array(
              'type' => 'accounts',
              'id' => $payee_id
            ),
          ),
        )
      ),
    ));
    $options = array(
      'method' => 'POST',
      'data' => $data,
      'headers' => array(
        'Authorization' => 'Bearer ' . $token,
        'Content-Type' => 'application/vnd.api+json',
      ),
    );
    $result = drupal_http_request($url, $options);
    $this->verbose(highlight_string('<?php ' . var_export($result, TRUE), TRUE));
    $this->assertEqual($result->code, $status, format_string('Status code should be @status but is @code', array('@status' => $status, '@code' => $result->code)));
    $this->assertEqual($result->headers['content-type'], "application/vnd.api+json");
    $data = json_decode($result->data);
    if ($status == 201) {
      $this->assertEqual($data->data->attributes->state, 'committed');
      $this->assertEqual($data->data->id, $id);
    }
    return $data;
  }
  /**
   * Test GET /transfers/id
   *
   * @return The decoded object in data response.
   */
  protected function getKomunitinTransfer($token, $exchange_id, $id, $status = 200, $transfer = NULL)
  {
    $url = url('ces/api/accounting/' . $exchange_id . '/transfers/' . $id, array('absolute' => TRUE));
    $options = array(
      'headers' => array(
        'Authorization' => 'Bearer ' . $token
      )
    );
    $result = drupal_http_request($url, $options);
    $this->verbose(highlight_string('<?php ' . var_export($result, TRUE), TRUE));
    $this->assertEqual($result->code, $status, 'Get transfer status code.');
    $this->assertEqual($result->headers['content-type'], "application/vnd.api+json");
    $response = json_decode($result->data);
    if ($transfer != NULL) {
      $this->assertEqual($transfer->data->id, $response->data->id);
      $this->assertEqual($transfer->data->attributes->state, $response->data->attributes->state);
      $this->assertEqual($transfer->data->relationships->payer->data->id, $response->data->relationships->payer->data->id);
      $this->assertEqual($transfer->data->relationships->payee->data->id, $response->data->relationships->payee->data->id);
      $this->assertEqual($transfer->data->attributes->amount, $response->data->attributes->amount);
      $this->assertEqual($transfer->data->attributes->meta, $response->data->attributes->meta);
    }
    return $response;
  }
  /**
   * Test DELETE /transfers/id
   */
  protected function deleteKomunitinTransfer($token, $exchange_id, $id, $status = 204)
  {
    $url = url('ces/api/accounting/' . $exchange_id . '/transfers/' . $id, array('absolute' => TRUE));
    $options = array(
      'method' => 'DELETE',
      'headers' => array(
        'Authorization' => 'Bearer ' . $token
      )
    );
    $result = drupal_http_request($url, $options);
    $this->verbose(highlight_string('<?php ' . var_export($result, TRUE), TRUE));
    $this->assertEqual($result->code, $status, format_string('Status code should be @status but is @code', array('@status' => $status, '@code' => $result->code)));
  }

  /**
   * Test GET /transfers?filter[account]=XXX&sort=-updated
   */
  protected function listTransfers($token, $exchange_id, $account, $status = 200, $transactions = null) {
    $url = url('ces/api/accounting/' . $exchange_id . '/transfers', array(
      'absolute' => TRUE,
      'query' => array(
        'filter[account]' =>$account,
        'sort' => '-updated'
      ))
    );
    $options = array(
      'headers' => array(
        'Authorization' => 'Bearer ' . $token
      )
    );
    $result = drupal_http_request($url, $options);
    $this->verbose(highlight_string('<?php ' . var_export($result, TRUE), TRUE));
    $this->assertEqual($result->code, $status, format_string('Status code should be @status but is @code', array('@status' => $status, '@code' => $result->code)));
    $response = json_decode($result->data);
    if ($transactions !== null) {
      $this->assertEqual(count($response->data), count($transactions), 'Incorrect number of transactions');
      $i = 0;
      foreach($transactions as $transaction) {
        $this->assertEqual($response->data[$i]->id, $transaction->data->id, 'Found unexpected transaction in list.');
        $i++;
      }
    }
  }

  /**
   * Call to the token endpoint with credentials from given user.
   *
   * @return The access_token string.
   */
  protected function authorize($mail, $password)
  {
    $data = array(
      'grant_type' => 'password',
      'username' => $mail,
      'password' => $password,
      'client_id' => 'komunitin-app',
      'scope' => 'komunitin_accounting'
    );

    $options = array(
      'method' => 'POST',
      'data' => http_build_query($data),
      'headers' => array(
        'Content-Type' => 'application/x-www-form-urlencoded',
      ),
    );

    $url = url('oauth2/token', array('absolute' => TRUE));

    $response = drupal_http_request($url, $options);

    $result = json_decode($response->data);
    return ($result->access_token);
  }

  /**
   * Generate v4 uuid.
   *
   * From https://stackoverflow.com/questions/2040240/php-function-to-generate-v4-uuid
   */
  protected function uuid()
  {
    $data = random_bytes(16);
    $data[6] = chr(ord($data[6]) & 0x0f | 0x40); // set version to 0100
    $data[8] = chr(ord($data[8]) & 0x3f | 0x80); // set bits 6-7 to 10
    return vsprintf('%s%s-%s-%s-%s-%s%s%s', str_split(bin2hex($data), 4));
  }
}
