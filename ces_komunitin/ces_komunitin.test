  /**
   * Test the social API.
   */
  protected function doSocialApi()
  {
    // Unauthenticated

    // Get single group
    $hora = $this->getGroup(false, 'HORA');
    $bcna = $this->getGroup(false, 'BCNA');
    $this->getGroup(false, 'XYZT', 404); // Group not found

    // Get list of groups.
    $this->listGroups(false, null, [0,0], 200, [$hora->data->id, $bcna->data->id]);

    // Authenticate as HORA0001
    $account = $this->account11;
    $token = $this->authorize($account['account']['mail'], $account['account']['pass_raw']);

    // Get the /me endpoint.
    $me = $this->getUsersMe($token);

    // Get single member.
    $account12 = $this->getMember($token, 'HORA', 'account12');
    $adminhora = $this->getMember($token, 'HORA', 'adminhora');

    // Get all exchange members.
    $members = $this->listMembers($token, 'HORA', 200, [$adminhora->data->id, $me->included[0]->id, $account12->data->id]);

    // Get single offer.
    $offer = $this->getOffer($token, 'HORA', 'potatoes');
    // List group offers
    $uuids = array_map(function ($offer) {
      return ces_komunitin_api_social_get_uuid(ResourceTypes::OFFER, $offer->id);
    }, $this->offers);
    $offers = $this->listOffers($token, 'HORA', [], 200, $uuids);
    // List account offers
    $account1_offers = $this->listOffers($token, 'HORA', ['member' => $me->included[0]->id], 200, [$uuids[0], $uuids[1]]);
    $account2_offers = $this->listOffers($token, 'HORA', ['member' => $account12->data->id], 200, [$uuids[2]]);
    // Get single need.
    $need = $this->getNeed($token, 'HORA', 'milk');
    // List group needs
    $uuids = array_map(function ($want) {
      return ces_komunitin_api_social_get_uuid(ResourceTypes::NEED, $want->id);
    }, $this->wants);
    $needs = $this->listNeeds($token, 'HORA', [], 200, $uuids);
    // List account needs
    $account1_needs = $this->listNeeds($token, 'HORA', ['member' => $me->included[0]->id], 200, [$uuids[0]]);
  }
  protected function getGroup($token, $code, $status = 200) {
    $result = $this->request("ces/api/social/$code", $token, ['query' => ['include' => 'contacts']], [], $status);
    $response = json_decode($result->data);

    // Check group code.
    if ($status == 200) {
      //check type
      $this->assertEqual($response->data->type, 'groups');
      // check group code
      $this->assertEqual($response->data->attributes->code, $code);
      // check currency link
      $this->assertEqual($response->data->relationships->currency->links->related, url('ces/api/accounting/' . $code . '/currency', ['absolute' => TRUE]));
      // check contact id.
      $this->assertEqual($response->data->relationships->contacts->data[0]->id, $response->included[0]->id);
    }
    return $response;
  }
  protected function listGroups($token, $search = null, $position = [0,0], $status = 200, $ids = null) {
    $query = [];
    $query['include'] = 'contacts';
    if ($position) {
      $query['geo-position'] = implode(",", $position);
      $query['sort'] = 'location';
    }
    if ($search) {
      $query['filter[serch]'] = $search;
    }
    $result = $this->request('ces/api/social/groups', $token, ['query' => $query], [], $status);
    $response = json_decode($result->data);

    if ($status == 200) {
      $this->assertIds($response, $ids);
      // There's one contact per group
      $this->assertEqual(count($response->included), count($response->data));
    }
  }

  protected function getUsersMe($token, $status = 200) {
    $result = $this->request('ces/api/social/users/me', $token, ['query' => ['include' => 'members,members.group,members.contacts']], [], $status);
    if ($status == 200) {
      $response = json_decode($result->data);
      $user = $response->data;
      $member = $response->included[0];
      $group = $response->included[1];
      $mail = $response->included[2];
      $phone = $response->included[3];

      // assert user-member link.
      $this->assertEqual($member->type, 'members');
      $this->assertEqual($member->id, $user->relationships->members->data[0]->id);

      // assert member-group link.
      $this->assertEqual($group->type, 'groups');
      $this->assertEqual($group->id, $member->relationships->group->data->id);

      $this->assertEqual($mail->type, 'contacts');
      $this->assertEqual($mail->attributes->type, 'email');

      $this->assertEqual($phone->type, 'contacts');
      $this->assertEqual($phone->attributes->type, 'phone');
    }
    return $response;

  }
  protected function getMember($token, $groupCode, $code, $status = 200) {
    $result = $this->request("ces/api/social/$groupCode/members/$code", $token, ['query' => ['include' => 'contacts']], [], $status);
    if ($status == 200) {
      $response = json_decode($result->data);
      $this->assertEqual($response->data->attributes->code, $code);
      // two contact objects (email & phone)
      $this->assertEqual(count($response->included), 2);
      $this->assertEqual(count($response->data->relationships->contacts->data), 2);
      return $response;
    }
  }
  protected function listMembers($token, $groupCode, $status = 200, $ids = null) {
    $result = $this->request("ces/api/social/$groupCode/members", $token, ['query' => ['include' => 'contacts']], [], $status);
    if ($status == 200) {
      $response = json_decode($result->data);
      $this->assertIds($response, $ids);
      // two contacts per member.
      $this->assertEqual(count($response->data) * 2, count($response->included));
    }
  }
  protected function getOffer($token, $groupCode, $code, $status = 200) {
    return $this->getOfferNeed('offers', $token, $groupCode, $code, $status);
  }
  protected function getNeed($token, $groupCode, $code, $status = 200) {
    return $this->getOfferNeed('needs', $token, $groupCode, $code, $status);
  }
  protected function getOfferNeed($type, $token, $groupCode, $code, $status = 200) {
    $result = $this->request("ces/api/social/$groupCode/$type/$code", $token, ['query' => ['include' => 'category,member,member.contacts']], [], $status);
    if ($status == 200) {
      $response = json_decode($result->data);
      // Assert correct code.
      $this->assertEqual($response->data->attributes->code, $code);
      // Assert existence of included objects.
      $this->assertEqual($response->included[0]->type, 'categories');
      $this->assertEqual($response->included[1]->type, 'members');
      $this->assertEqual($response->included[2]->type, 'contacts');
      return $response;
    }
  }
  protected function listOffers($token, $groupCode, $filters, $status = 200, $ids) {
    return $this->listOffersNeeds('offers', $token, $groupCode, $filters, $status, $ids);
  }
  protected function listNeeds($token, $groupCode, $filters, $status = 200, $ids)
  {
    return $this->listOffersNeeds('needs', $token, $groupCode, $filters, $status, $ids);
  }
  private function listOffersNeeds($type, $token, $groupCode, $filters = [], $status = 200, $ids) {
    $urlargs = ['query' => ['include' => 'category,member,member.contacts']];
    if (!empty($filters)) {
      $urlargs['query']['filter'] = $filters;
    }
    $result = $this->request("ces/api/social/$groupCode/$type", $token, $urlargs, [], $status);
    if ($status == 200) {
      $response = json_decode($result->data);
      $this->assertIds($response, $ids);
      return $response;
    }
    return FALSE;
  }
  /**
   * HElper functin to assert the ids of a returned object collection.
  */
  private function assertIds($response, $ids = null) {
    if ($ids != null) {
      $i = 0;
      foreach ($ids as $id) {
        $this->assertEqual($response->data[$i++]->id, $id);
      }
    }
  }
  /**
   * Call to the token endpoint with credentials from given user.
   *
   * @return The access_token string.
   */
  protected function authorize($mail, $password)
  {
    $data = array(
      'grant_type' => 'password',
      'username' => $mail,
      'password' => $password,
      'client_id' => 'komunitin-app',
      'scope' => 'komunitin_accounting komunitin_social'
    );

    $options = array(
      'method' => 'POST',
      'data' => http_build_query($data),
      'headers' => array(
        'Content-Type' => 'application/x-www-form-urlencoded',
      ),
    );

    $url = url('oauth2/token', array('absolute' => TRUE));

    $response = drupal_http_request($url, $options);

    $result = json_decode($response->data);
    return ($result->access_token);
  }

  /**
   * Generate v4 uuid.
   *
   * From https://stackoverflow.com/questions/2040240/php-function-to-generate-v4-uuid
   */
  protected function uuid()
  {
    $data = random_bytes(16);
    $data[6] = chr(ord($data[6]) & 0x0f | 0x40); // set version to 0100
    $data[8] = chr(ord($data[8]) & 0x3f | 0x80); // set bits 6-7 to 10
    return vsprintf('%s%s-%s-%s-%s-%s%s%s', str_split(bin2hex($data), 4));
  }

  protected function request($url, $token, $url_options = [], $request_options = [], $status = 200) {
    $url_options = array_merge(['absolute' => TRUE], $url_options);
    $url = url($url, $url_options);
    if ($token) {
      $request_options = array_merge_recursive(['headers' => ['Authorization' => 'Bearer ' . $token]], $request_options);
    }
    $result = drupal_http_request($url, $request_options);

    $this->verbose(highlight_string('<?php ' . var_export($result, TRUE), TRUE));
    $this->assertEqual($result->code, $status, format_string('Status code should be @status but is @code', array('@status' => $status, '@code' => $result->code)));

    return $result;
  }


}

